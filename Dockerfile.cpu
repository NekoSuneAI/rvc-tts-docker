FROM python:3.10-slim

# Install system deps
RUN apt-get update && apt-get install -y \
    git ffmpeg libsm6 libxext6 \
    && rm -rf /var/lib/apt/lists/*



# Clone your RVC-TTS WebUI
RUN git clone https://github.com/NekoSuneAI/rvc-tts-webui /app
WORKDIR /app

# Install PyTorch CPU version
RUN pip install --no-cache-dir \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cpu

# Install fairseq (CPU wheel, no CUDA build)
RUN pip install --no-cache-dir fairseq2

# Optional: transformers + accelerate for CPU-only pipelines
RUN pip install --no-cache-dir \
    edge-tts \
    transformers \
    accelerate

# Expose WebUI HTTP port
EXPOSE 7860

CMD ["python3", "app.py", "--port", "7860", "--share", "False"]
