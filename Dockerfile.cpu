FROM python:3.10-slim

# Install system deps
RUN apt-get update && apt-get install -y \
    git ffmpeg curl libsm6 libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Clone your RVC-TTS WebUI
RUN if [ -d /app ]; then rm -rf /app; fi && \
    git clone https://github.com/NekoSuneAI/rvc-tts-webui /app
WORKDIR /app

# Download Hubert & RMVPE models
RUN curl -L -o /app/hubert_base.pt https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/hubert_base.pt && \
    curl -L -o /app/rmvpe.pt https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/rmvpe.pt

# Install PyTorch CPU
RUN pip install --no-cache-dir torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cpu

# Install Python requirements
RUN pip install --no-cache-dir -r requirements.txt

# Expose WebUI HTTP port
EXPOSE 7860

CMD ["python3", "app.py", "--port", "7860", "--share", "False"]
