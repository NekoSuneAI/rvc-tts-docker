FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y \
    python3 python3-pip git ffmpeg libsm6 libxext6 \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/NekoSuneAI/rvc-tts-webui /app
WORKDIR /app

RUN pip3 install --upgrade pip

# Install PyTorch for CUDA 11
RUN pip3 install --no-cache-dir \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu118

RUN pip3 install --no-cache-dir fairseq
RUN pip3 install --no-cache-dir transformers accelerate

EXPOSE 7860
CMD ["python3", "app.py", "--port", "7860", "--share", "False"]
